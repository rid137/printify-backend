# # Environment example (do not commit real secrets)

# NODE_ENV=development
# PORT=8080
# MONGO_URI=mongodb://127.0.0.1:27017/printify
# # Production: at least 32 characters; values like change-me are rejected.
# JWT_SECRET=change-me

# # Frontend (comma-separated origins supported). Required in production.
# FRONTEND_URL=http://localhost:3000
# # Optional. Defaults to {first FRONTEND_URL}/payment/verify
# FRONTEND_VERIFY_PAYMENT_URL=http://localhost:3000/payment/verify

# # Optional dedicated HMAC pepper for OTPs (defaults to JWT_SECRET)
# # OTP_PEPPER=

# # Paystack
# # Production requires PAYSTACK_SECRET_KEY (test-key fallback is development/test only).
# PAYSTACK_SECRET_KEY=
# # Fallback for local/dev only:
# # PAYSTACK_TEST_SECRET_KEY=

# # Cloudinary (server-side only — never expose API secret to the frontend)
# # Production requires all three.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# # Upload: per-file maximum size in megabytes (default 10)
# MAX_UPLOAD_SIZE_MB=10

# # Swagger UI at /docs and /docs.json
# # Default: enabled in development, disabled in production.
# # Set true to expose docs in production, or false to disable in development.
# # ENABLE_SWAGGER=true

# # Email (optional — API boots without SMTP)
# # EMAIL_HOST=smtp.example.com
# # EMAIL_PORT=465
# # EMAIL_USER=
# # EMAIL_PASS=
# # EMAIL_FROM_NAME=Printify
# # APP_NAME=Printify
# # SUPPORT_EMAIL=support@example.com

# # Firebase Admin (optional — API boots without FCM)
# # FIREBASE_PROJECT_ID=
# # FIREBASE_CLIENT_EMAIL=
# # FIREBASE_PRIVATE_KEY=
# # FIREBASE_DATABASE_URL=

# # Reverse proxy hops for req.ip / rate limiting.
# # Production defaults to 1 if unset. Set 0/false to disable.
# # TRUST_PROXY=1
